#!/usr/bin/env bash
set -euo pipefail

DEPLOYMENT="messaging_app"
NAMESPACE="default"
URL="http://<YOUR_APP_URL_OR_SERVICE_ENDPOINT>"
SLEEP_INTERVAL=1

echo "Applying updated deployment (image: 2.0)..."
kubectl apply -f blue_deployment.yaml -n "$NAMESPACE"

echo "Triggering rolling update..."
kubectl rollout status deployment/"$DEPLOYMENT" -n "$NAMESPACE" --watch

echo "Starting continuous availability checks..."
(sleep 2 && while true; do
    curl -s -o /dev/null -w "%{http_code}\n" "$URL" || echo "Curl failed at $(date)"
    sleep "$SLEEP_INTERVAL"
done) &
CURL_PID=$!

echo "Waiting for rollout to complete..."
kubectl rollout status deployment/"$DEPLOYMENT" -n "$NAMESPACE"

echo "Rolling update complete. Checking existing pods:"
kubectl get pods -l app=messaging_app -n "$NAMESPACE"

echo "Stopping continuous curl checks..."
kill $CURL_PID 2>/dev/null || true

echo "Update finished successfully."